{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/parfenovvs/lazylogcat/raw/trunk/config.schema.json",
  "title": "lazylogcat configuration",
  "description": "Configuration file for lazylogcat. Used in ~/.config/lazylogcat/config.json (global), .lazylogcat/config.json (project), and .lazylogcat/config.local.json (local override). All fields are optional — layers are merged in order: defaults → global → project → local.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path or URL to this schema file, for editor validation."
    },
    "display": {
      "type": "object",
      "description": "Log output appearance settings.",
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "boolean",
          "description": "Enable log colorization by level.",
          "default": true
        },
        "wrap": {
          "type": "boolean",
          "description": "Enable soft-wrapping of long log lines to fit the terminal width.",
          "default": true
        },
        "tag_width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99,
          "description": "Fixed width for the log tag column (terminal display width). Use 0 for automatic width."
        },
        "columns": {
          "type": "object",
          "description": "Controls which fields of a parsed log line are visible.",
          "additionalProperties": false,
          "properties": {
            "date": {
              "type": "boolean",
              "description": "Show the date column.",
              "default": false
            },
            "time": {
              "type": "boolean",
              "description": "Show the time column.",
              "default": true
            },
            "pid": {
              "type": "boolean",
              "description": "Show the PID (process ID) column.",
              "default": false
            },
            "tid": {
              "type": "boolean",
              "description": "Show the TID (thread ID) column.",
              "default": false
            },
            "level": {
              "type": "boolean",
              "description": "Show the log level column.",
              "default": true
            },
            "tag": {
              "type": "boolean",
              "description": "Show the log tag column.",
              "default": true
            },
            "message": {
              "type": "boolean",
              "description": "Show the message column.",
              "default": true
            }
          }
        }
      }
    },
    "filter": {
      "type": "object",
      "description": "Log filtering parameters. Each filter field accepts either a plain string or an object with a \"value\" field.",
      "additionalProperties": false,
      "properties": {
        "package_name": {
          "$ref": "#/$defs/text_filter",
          "description": "Android package name to filter logs by (e.g. \"com.example.app\")."
        },
        "log_tag": {
          "$ref": "#/$defs/text_filter",
          "description": "Logcat tag to filter by (e.g. \"MyTag\")."
        },
        "log_text": {
          "$ref": "#/$defs/text_filter",
          "description": "Text content to search for in log lines."
        }
      }
    }
  },
  "$defs": {
    "text_filter": {
      "description": "A filter value. Accepts a plain string (shorthand for contains mode) or an object with \"value\" and optional \"mode\" fields.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string",
              "description": "The filter value."
            },
            "mode": {
              "type": "string",
              "enum": ["contains", "exact", "regex"],
              "description": "Matching mode. \"contains\" matches case-insensitive substrings, \"exact\" matches case-insensitive full strings, \"regex\" matches case-insensitive regular expressions.",
              "default": "contains"
            }
          },
          "required": ["value"]
        }
      ]
    }
  }
}
